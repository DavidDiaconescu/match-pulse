# Copy to .env and edit if needed: cp .env.example .env
# Every value has a default in docker-compose.yml, so .env is optional.

# --- Kafka (David) ------------------------------------------------------------
KAFKA_IMAGE_TAG=4.1.0
# Host port for the EXTERNAL listener -> scripts connect to localhost:9094
KAFKA_HOST_PORT=9094
# Any base64 UUID (generate with: docker run --rm apache/kafka:4.1.0 /opt/kafka/bin/kafka-storage.sh random-uuid)
# If you change it, run `docker compose down -v` first: existing data belongs to the old id.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# --- Kafka UI (David) ---------------------------------------------------------
KAFKA_UI_IMAGE_TAG=v1.3.0
KAFKA_UI_PORT=8080

# --- Replay producer (David, Phase 2) -----------------------------------------
# Bootstrap used by host-side scripts. Inside Docker use kafka:9092.
KAFKA_BOOTSTRAP=localhost:9094

# --- MinIO / Delta Lake (Mihai) - placeholders --------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
LAKE_BUCKET=lake

# --- Redis / Grafana (Dayana) - placeholders ----------------------------------
REDIS_PORT=6379
GRAFANA_PORT=3000
